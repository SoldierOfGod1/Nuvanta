# Copy to .env.local for local dev. Set the same vars in Vercel for production.

# ── Site ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Nuvanta
NEXT_PUBLIC_FOUNDER_NAME=Baptista
NEXT_PUBLIC_WHATSAPP_NUMBER=27000000000
NEXT_PUBLIC_SUPPORT_EMAIL=hello@nuvanta.co.za

# ── PayFast (sandbox values shown — replace with live for production) ──
# Sandbox dashboard: https://sandbox.payfast.co.za
# Production dashboard: https://www.payfast.co.za
PAYFAST_SANDBOX=true
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
PAYFAST_PASSPHRASE=
# Optional: leave empty for sandbox (most sandbox accounts have no passphrase)

# ── Resend (transactional email) ──
# Sign up free at https://resend.com — 3,000 emails/mo on free tier
RESEND_API_KEY=re_test_xxxxxxxxxxxxxxx
EMAIL_FROM=hello@nuvanta.co.za
EMAIL_FOUNDER=baptista@nuvanta.co.za

# ── Tracking pixels (loaded only after cookie consent) ──
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# ── Webhook security ──
# A long random string. Used to validate that webhook calls come from PayFast IPs only.
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=replace-with-random-32-byte-hex
